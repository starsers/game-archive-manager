<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="game_archive_manager.Controls.ImageUploader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:game_archive_manager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Upload Image" Click="UploadImageButton_Click" Margin="10"/>
            <Image x:Name="UploadedImage" Width="200" Height="200" Margin="10"/>
        </StackPanel>
    </Grid>
</UserControl>
