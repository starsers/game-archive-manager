<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="game_archive_manager.Controls.ContentShow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:game_archive_manager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- 左按钮 -->
            <ColumnDefinition Width="*"/>
            <!-- 内容区域 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 右按钮 -->
        </Grid.ColumnDefinitions>

        <!-- 左侧按钮 -->
        <Button x:Name="PreviousButton"
                Grid.Column="0"
                Content="&lt;"
                VerticalAlignment="Center"
                Margin="0,0,10,0"
                Click="OnPreviousClick"/>

        <!-- 内容容器 -->
        <Border x:Name="ComponentsBorder"
                Grid.Column="1"

                Padding="10"
                HorizontalAlignment="Center">

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 组件1 -->
                <ContentControl x:Name="Component1Control" 
                               Grid.Column="0" 
                               Content="{Binding Component1}" Padding="20"/>

                <!-- 组件2 -->
                <ContentControl x:Name="Component2Control" 
                               Grid.Column="1" 
                               Content="{Binding Component2}" Padding="20"/>

                <!-- 组件3 -->
                <ContentControl x:Name="Component3Control" 
                               Grid.Column="2" 
                               Content="{Binding Component3}" Padding="20"/>
            </Grid>
        </Border>

        <!-- 右侧按钮 -->
        <Button x:Name="NextButton"
                Grid.Column="2"
                Content="&gt;"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                Click="OnNextClick"/>
    </Grid>
</UserControl>
