<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="game_archive_manager.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <TextBlock Text="用户登录" Style="{StaticResource TitleTextBlockStyle}" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBox x:Name="txtUsername" Header="用户名:" PlaceholderText="请输入用户名" 
                 Margin="0,0,0,10"/>

        <PasswordBox x:Name="txtPassword" Header="密码:" PlaceholderText="请输入密码" 
                     Margin="0,0,0,20"/>

        <Button x:Name="btnLogin" Content="登录" HorizontalAlignment="Stretch" 
                Click="btnLogin_Click"/>

        <HyperlinkButton x:Name="lnkRegister" Content="还没有账号？点击注册" 
                         HorizontalAlignment="Center" Margin="0,10,0,0" 
                         Click="lnkRegister_Click"/>

        <InfoBar x:Name="infoBar" IsOpen="False" Margin="0,10,0,0"/>
    </StackPanel>
</Page>