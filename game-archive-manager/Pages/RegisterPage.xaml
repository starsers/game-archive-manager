<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="game_archive_manager.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <TextBlock Text="用户注册" Style="{StaticResource TitleTextBlockStyle}" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBox x:Name="txtUsername" Header="用户名:" PlaceholderText="请输入用户名" 
                 Margin="0,0,0,10"/>

        <PasswordBox x:Name="txtPassword" Header="密码:" PlaceholderText="请输入密码" 
                     Margin="0,0,0,10"/>

        <PasswordBox x:Name="txtConfirmPassword" Header="确认密码:" 
                     PlaceholderText="请再次输入密码" Margin="0,0,0,20"/>

        <Button x:Name="btnRegister" Content="注册" HorizontalAlignment="Stretch" 
                Click="btnRegister_Click"/>

        <Button x:Name="btnBack" Content="返回登录" HorizontalAlignment="Stretch" 
                Margin="0,10,0,0" Click="btnBack_Click"/>

        <InfoBar x:Name="infoBar" IsOpen="False" Margin="0,10,0,0"/>
    </StackPanel>
</Page>
